# Copy this file to .env and fill in real values. Never commit .env itself.

# Client-side (Vite bundles anything prefixed VITE_ into the browser build -
# only ever put public-by-design values here, e.g. the Supabase anon/
# publishable key, never a secret).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side (read via process.env in *.server.ts files and server routes
# only - never prefix these with VITE_, or Vite will bundle them into the
# client build and leak them).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Used by src/integrations/supabase/client.server.ts to bypass RLS for
# trusted server-side operations. This is a real secret - treat it like a
# password. Never expose it to client code, never commit a real value here.
SUPABASE_SERVICE_ROLE_KEY=
